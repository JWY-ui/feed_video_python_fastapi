# 服务器
SERVER_PORT=8080

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=feedsystem

# JWT
JWT_SECRET=change-me-to-a-random-string

# Redis
# 缓存和限流在 Redis 不可用时会降级；但分片上传会话、通知推送和 Agent 的
# 会话锁**依赖** Redis（不可用时对应接口返回 503）。
# Docker Compose 部署时密码必填（compose 里用 :? 做了非空校验）。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM / Agent (app/agent_v3)
# 走 OpenAI 兼容协议，默认指向 DeepSeek。OPENAI_API_KEY 为空时
# /agent/* 全部返回 503 —— agent 没有降级模式，不配就是不可用。
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 单次 LLM 调用的重试次数与超时（秒）
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_TIMEOUT=60
# 单轮最多工具调用次数、上下文 token 预算
AGENT_MAX_TOOL_TURNS=8
AGENT_MAX_CONTEXT_TOKENS=12000

# ---- 部署（Docker Compose 读取同一份 .env）----
# 下面三个在 compose 里是必填项，留空会直接启动失败：
#   JWT_SECRET / MYSQL_ROOT_PASSWORD / REDIS_PASSWORD
# 生产环境请用随机长字符串生成，不要沿用示例值。

# 允许跨域的前端源，逗号分隔；"*" 仅供本地开发
CORS_ORIGINS=*
# uvicorn worker 数。进程内状态已迁到 Redis，可以 >1；小服务器保持 1。
WEB_CONCURRENCY=1
# 信任的反向代理地址。后端端口只绑在 127.0.0.1，* 表示信任本机/容器网络内的代理。
FORWARDED_ALLOW_IPS=*
